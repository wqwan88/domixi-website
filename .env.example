# ── M-Pesa Daraja API 凭证 ──
# 沙箱凭证在 https://developer.safaricom.co.ke 的应用页面获取
# 生产环境使用 Daraja 门户正式应用的凭证
MPESA_CONSUMER_KEY=your_c…here
MPESA_CONSUMER_SECRET=your_c…here
# 沙箱标准 Shortcode 174379 + 官方测试 Passkey（公开值，仅沙箱）
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_SHORTCODE=174379
MPESA_ENV=sandbox

# ── M-Pesa 回调地址（必须 HTTPS 公网可达） ──
# 开发环境用隧道（如 cloudflared）暴露本地 3000 端口后拼上 /api/mpesa/callback
# 例如: https://your-tunnel.trycloudflare.com/api/mpesa/callback
# 生产环境: https://你的域名/api/mpesa/callback
MPESA_CALLBACK_URL=https://YOUR_DOMAIN/api/mpesa/callback

# ── SQLite 数据库路径（可选，默认 <cwd>/data/mpesa.db） ──
# MPESA_DB_PATH=/app/data/mpesa.db
